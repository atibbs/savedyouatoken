# savedyouatoken — environment configuration
#
# Everything here is OPTIONAL. With none of it set, the app runs as a fully static, free,
# no-account tool. Copy to `.env.local` and fill in as you activate a feature. Never commit
# real secrets.
#
# The Pro stack (accounts, saved-prompt history, billing) is not part of this repository — it's
# specced but deliberately unbuilt (see docs/decisions.md) and, if built, would live in the
# private savedyouatoken-cloud repository, not here.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://savedyouatoken.com

# The Gumroad product page for the downloadable agent kit. Until this is set, the /kit page
# and its "Get the kit" CTAs show a "coming soon" state; setting it makes them live outbound
# links. NEXT_PUBLIC_* values are inlined at build time, so changing this needs a redeploy.
NEXT_PUBLIC_KIT_URL=
