# savedyouatoken — environment configuration
#
# Everything here is OPTIONAL. With none of it set, the app runs as a fully static, free,
# no-account tool. Each block below switches on a piece of the Pro stack. Copy to
# `.env.local` and fill in as you activate features. Never commit real secrets.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://savedyouatoken.com

# The Gumroad product page for the downloadable agent kit. Until this is set, the /kit page
# and its "Get the kit" CTAs show a "coming soon" state; setting it makes them live outbound
# links. NEXT_PUBLIC_* values are inlined at build time, so changing this needs a redeploy.
NEXT_PUBLIC_KIT_URL=

# ---------------------------------------------------------------------------
# Auth (Auth.js v5) — needed for accounts and anything Pro
# ---------------------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local development only: set to "true" to enable a mock email login so signed-in flows can
# be exercised without configuring OAuth. Ignored in production.
ALLOW_DEV_LOGIN=

# ---------------------------------------------------------------------------
# Database (Postgres) — needed for saved-prompt history and entitlements
# ---------------------------------------------------------------------------
# A free-tier Neon or Supabase connection string. Use the POOLED connection.
# Then create the schema:  npm run db:push   (or run drizzle/0000_init.sql)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Billing (Stripe) — wired in the billing layer; inactive until set
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
