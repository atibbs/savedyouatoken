{
  "name": "@savedyouatoken/sdk",
  "version": "0.2.1",
  "description": "Wrap your Anthropic/OpenAI client and get a token-waste audit of the real request — no prompt leaves your process.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-dts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "tokens",
    "prompt",
    "cost",
    "openai",
    "anthropic",
    "observability"
  ],
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@savedyouatoken/core": "*",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atibbs/savedyouatoken.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://savedyouatoken.com/sdk",
  "bugs": {
    "url": "https://github.com/atibbs/savedyouatoken/issues"
  }
}
